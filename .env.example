# BreakGen Environment Configuration
# Copy this file to .env and fill in your values

# Debug mode (disable in production)
BREAKGEN_DEBUG=true

# Database (default: SQLite in server directory)
# BREAKGEN_DATABASE_URL=sqlite+aiosqlite:///./breakgen.db

# Artifact storage (default: server/artifacts)
# BREAKGEN_ARTIFACTS_DIR=./server/artifacts

# JWT auth
# Required when BREAKGEN_DEBUG=false
BREAKGEN_JWT_SECRET=replace-with-a-long-random-secret
BREAKGEN_JWT_EXPIRE_HOURS=72

# Private-alpha signup controls
BREAKGEN_PUBLIC_SIGNUP_ENABLED=false
# Required if public signup is enabled outside local debug
BREAKGEN_SIGNUP_INVITE_CODE=

# Comma-separated frontend origins trusted by the API
BREAKGEN_CORS_ORIGINS=http://localhost:5173,https://parthawe.github.io
BREAKGEN_CORS_ALLOW_CREDENTIALS=true

# Meshy AI API key (optional — stub mode used when empty)
BREAKGEN_MESHY_API_KEY=
