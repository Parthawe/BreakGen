FROM node:22-slim AS client-build

WORKDIR /build/client

RUN npm install -g pnpm@9

COPY client/package.json client/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY client/ ./
ENV VITE_PUBLIC_SITE=false
ENV VITE_BASE_PATH=/
ENV VITE_API_BASE_URL=/api
RUN pnpm build


FROM python:3.12-slim

WORKDIR /app

ENV PYTHONPATH=/app
ENV BREAKGEN_DEBUG=false
ENV BREAKGEN_ARTIFACTS_DIR=/app/data/artifacts
ENV BREAKGEN_UVICORN_WORKERS=1

RUN pip install --no-cache-dir uv

COPY alembic.ini /app/alembic.ini
COPY server/pyproject.toml server/uv.lock /app/server/
RUN cd server && uv sync --frozen --no-dev

COPY server/ /app/server/
COPY --from=client-build /build/client/dist /app/client/dist
COPY docker/entrypoint.prod.sh /app/docker/entrypoint.prod.sh

RUN chmod +x /app/docker/entrypoint.prod.sh \
    && mkdir -p /app/data/artifacts

EXPOSE 8000

ENTRYPOINT ["/app/docker/entrypoint.prod.sh"]
